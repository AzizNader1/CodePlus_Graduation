@model List<SkillSwap.Application.DTOs.ReportDTO>
@{
    ViewData["Title"] = "Platform Administration Portal";
    var stats = ViewBag.Stats as AdminDashboardStatsDTO ?? new AdminDashboardStatsDTO();
}

<div class="container-xl py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <span class="badge bg-danger rounded-pill px-3 py-1 mb-1">ADMINISTRATOR</span>
            <h3 class="fw-bold mb-0">Platform Administration Dashboard</h3>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row g-4 mb-5">
        <div class="col-lg-2 col-md-4 col-6">
            <div class="card card-custom p-3 bg-white border text-center">
                <small class="text-muted fw-bold text-uppercase d-block mb-1" style="font-size:0.75rem;">Users</small>
                <h3 class="fw-bold text-primary mb-0">@stats.TotalRegisteredUsers</h3>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="card card-custom p-3 bg-white border text-center">
                <small class="text-muted fw-bold text-uppercase d-block mb-1" style="font-size:0.75rem;">Active Swaps</small>
                <h3 class="fw-bold text-success mb-0">@stats.ActiveSwapsCount</h3>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="card card-custom p-3 bg-white border text-center">
                <small class="text-muted fw-bold text-uppercase d-block mb-1" style="font-size:0.75rem;">Completed</small>
                <h3 class="fw-bold text-info mb-0">@stats.CompletedSessionsCount</h3>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="card card-custom p-3 bg-white border text-center">
                <small class="text-muted fw-bold text-uppercase d-block mb-1" style="font-size:0.75rem;">Reports</small>
                <h3 class="fw-bold text-danger mb-0">@stats.OpenReportsCount</h3>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="card card-custom p-3 bg-white border text-center">
                <small class="text-muted fw-bold text-uppercase d-block mb-1" style="font-size:0.75rem;">Skills Listed</small>
                <h3 class="fw-bold text-warning mb-0">@stats.TotalSkillsListed</h3>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="card card-custom p-3 bg-white border text-center">
                <small class="text-muted fw-bold text-uppercase d-block mb-1" style="font-size:0.75rem;">Volume</small>
                <h3 class="fw-bold text-secondary mb-0">$@stats.TotalPaymentVolume.ToString("F0")</h3>
            </div>
        </div>
    </div>

    <!-- Moderation Reports Table -->
    <div class="card card-custom p-4 bg-white border">
        <h5 class="fw-bold mb-3"><i class="bi bi-shield-exclamation text-danger me-2"></i>Community Moderation Reports</h5>

        @if (!Model.Any())
        {
            <div class="p-4 text-center bg-light rounded-4">
                <p class="text-muted small mb-0">No moderation reports currently filed.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-muted text-uppercase">
                        <tr>
                            <th>Report ID</th>
                            <th>Reporter</th>
                            <th>Reported User</th>
                            <th>Category</th>
                            <th>Details</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var report in Model)
                        {
                            <tr>
                                <td><code class="text-dark">@report.Id.ToString().Substring(0, 8)...</code></td>
                                <td><strong>@report.ReporterName</strong></td>
                                <td><span class="text-danger fw-semibold">@report.ReportedUserName</span></td>
                                <td><span class="badge bg-light text-dark border">@report.ReasonCategory</span></td>
                                <td class="text-truncate" style="max-width: 250px;" title="@report.Details">@report.Details</td>
                                <td>
                                    <span class="badge @(report.Status == ReportStatus.Resolved ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-pill px-2 py-1">
                                        @report.Status
                                    </span>
                                </td>
                                <td>
                                    @if (report.Status != ReportStatus.Resolved)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#resolveModal-@report.Id">
                                            Resolve
                                        </button>

                                        <!-- Resolve Report Modal -->
                                        <div class="modal fade" id="resolveModal-@report.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold">Resolve Report</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form asp-action="ResolveReport" method="post">
                                                        <input type="hidden" name="reportId" value="@report.Id" />
                                                        <div class="modal-body py-4">
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-bold text-muted">Action Taken</label>
                                                                <select name="actionTaken" class="form-select rounded-3" required>
                                                                    <option value="WarningIssued">Issue Warning to User</option>
                                                                    <option value="ContentRemoved">Remove Inappropriate Content</option>
                                                                    <option value="UserSuspended">Suspend User Account</option>
                                                                    <option value="Dismissed">Dismiss (No Violation Found)</option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-bold text-muted">Admin Notes</label>
                                                                <textarea name="adminNotes" class="form-control rounded-3" rows="3" placeholder="Document the moderation findings and steps taken..." required></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Resolution</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-check-circle text-success me-1"></i>Resolved</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
