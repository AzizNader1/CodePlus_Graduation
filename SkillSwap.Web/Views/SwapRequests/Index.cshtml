@{
    ViewData["Title"] = "Swap Proposals & Negotiations";
    var incoming = ViewBag.Incoming as List<SwapRequestDTO> ?? new List<SwapRequestDTO>();
    var outgoing = ViewBag.Outgoing as List<SwapRequestDTO> ?? new List<SwapRequestDTO>();
}

<div class="container-xl py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold mb-1">Swap Requests Hub</h3>
            <p class="text-muted small mb-0">Manage incoming learning proposals, negotiate durations, and track requests.</p>
        </div>
        <a class="btn btn-primary-custom btn-sm" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i> Propose New Swap
        </a>
    </div>

    <!-- Nav Tabs -->
    <ul class="nav nav-pills mb-4 gap-2" id="swapTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 fw-semibold" id="incoming-tab" data-bs-toggle="pill" data-bs-target="#incoming" type="button" role="tab">
                Incoming Proposals <span class="badge bg-primary rounded-pill ms-1">@incoming.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-semibold" id="outgoing-tab" data-bs-toggle="pill" data-bs-target="#outgoing" type="button" role="tab">
                Outgoing Requests <span class="badge bg-secondary rounded-pill ms-1">@outgoing.Count</span>
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="swapTabsContent">
        <!-- Incoming Tab -->
        <div class="tab-pane fade show active" id="incoming" role="tabpanel">
            @if (!incoming.Any())
            {
                <div class="card card-custom p-5 text-center bg-white border">
                    <div class="rounded-circle bg-light text-muted d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width:64px; height:64px;">
                        <i class="bi bi-inbox fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-1">No incoming swap requests</h5>
                    <p class="text-muted small mb-0">@(ViewBag.IncomingMessage ?? "When other members propose to learn from you, their requests will appear here.")</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var swap in incoming)
                    {
                        <div class="col-lg-6">
                            <div class="card card-custom p-4 bg-white border h-100 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(swap.RequesterAvatarUrl))
                                        {
                                            <img src="http://localhost:5200@(swap.RequesterAvatarUrl)" alt="@swap.RequesterName" class="avatar-circle" style="width:48px; height:48px;" onerror="this.src='/images/default-avatar.png';">
                                        }
                                        else
                                        {
                                            var initial = !string.IsNullOrEmpty(swap.RequesterName) ? swap.RequesterName[0].ToString().ToUpper() : "U";
                                            <div class="avatar-placeholder" style="width:48px; height:48px;">@initial</div>
                                        }
                                        <div>
                                            <h6 class="fw-bold mb-0">@swap.RequesterName</h6>
                                            <small class="text-muted">Proposed @swap.CreatedAt.ToString("MMM dd, yyyy")</small>
                                        </div>
                                    </div>
                                    <span class="badge-status @swap.Status">@swap.Status</span>
                                </div>

                                <!-- Exchange Breakdown -->
                                <div class="p-3 bg-light rounded-4 mb-3 border">
                                    <div class="row g-2 align-items-center text-center">
                                        <div class="col-5">
                                            <small class="text-muted fw-bold d-block mb-1" style="font-size:0.75rem;">THEY TEACH</small>
                                            <span class="badge bg-primary text-white rounded-pill px-3 py-1">@swap.OfferedSkillName</span>
                                        </div>
                                        <div class="col-2">
                                            <i class="bi bi-arrow-left-right text-primary"></i>
                                        </div>
                                        <div class="col-5">
                                            <small class="text-muted fw-bold d-block mb-1" style="font-size:0.75rem;">YOU TEACH</small>
                                            <span class="badge bg-secondary text-white rounded-pill px-3 py-1">@swap.RequestedSkillName</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="small text-muted mb-3 d-flex flex-wrap gap-3">
                                    <span><i class="bi bi-calendar3 me-1 text-primary"></i>@swap.ProposedDate.ToString("ddd, MMM dd - hh:mm tt")</span>
                                    <span><i class="bi bi-clock me-1 text-primary"></i>@swap.DurationMinutes mins</span>
                                </div>

                                @if (!string.IsNullOrEmpty(swap.Notes))
                                {
                                    <p class="small text-muted bg-light p-2 rounded-3 mb-3">"@swap.Notes"</p>
                                }

                                <div class="mt-auto pt-2 border-top d-flex gap-2">
                                    @if (swap.Status == SwapRequestStatus.Pending || swap.Status == SwapRequestStatus.CounterOffered)
                                    {
                                        <form asp-action="Accept" method="post" class="flex-grow-1">
                                            <input type="hidden" name="swapRequestId" value="@swap.Id" />
                                            <button type="submit" class="btn btn-success btn-sm w-100 rounded-pill">
                                                <i class="bi bi-check-lg me-1"></i> Accept
                                            </button>
                                        </form>

                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#counterModal-@swap.Id">
                                            Counter
                                        </button>

                                        <form asp-action="Reject" method="post">
                                            <input type="hidden" name="swapRequestId" value="@swap.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                                                Reject
                                            </button>
                                        </form>
                                    }
                                    else if (swap.Status == SwapRequestStatus.Accepted)
                                    {
                                        <a class="btn btn-primary-custom btn-sm w-100" asp-controller="Sessions" asp-action="Index">
                                            <i class="bi bi-camera-video me-1"></i> View Scheduled Session
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Counter Offer Modal -->
                        <div class="modal fade" id="counterModal-@swap.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0 pb-0">
                                        <h5 class="modal-title fw-bold">Counter Offer Proposal</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form asp-action="CounterOffer" method="post">
                                        <input type="hidden" name="swapRequestId" value="@swap.Id" />
                                        <div class="modal-body py-4">
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-muted">Proposed New Date & Time</label>
                                                <input type="datetime-local" name="newTime" value="@swap.ProposedDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control rounded-3" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-muted">Duration (Minutes)</label>
                                                <select name="newDuration" class="form-select rounded-3">
                                                    <option value="30">30 Minutes</option>
                                                    <option value="45">45 Minutes</option>
                                                    <option value="60" selected>60 Minutes</option>
                                                    <option value="90">90 Minutes</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold text-muted">Counter Note</label>
                                                <textarea name="counterNotes" class="form-control rounded-3" rows="2" placeholder="Let them know why this time/duration works better..."></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0 pt-0">
                                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary-custom rounded-pill px-4">Submit Counter</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Outgoing Tab -->
        <div class="tab-pane fade" id="outgoing" role="tabpanel">
            @if (!outgoing.Any())
            {
                <div class="card card-custom p-5 text-center bg-white border">
                    <div class="rounded-circle bg-light text-muted d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width:64px; height:64px;">
                        <i class="bi bi-send fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-1">No outgoing swap requests</h5>
                    <p class="text-muted small mb-3">@(ViewBag.OutgoingMessage ?? "You haven't initiated any swap requests yet.")</p>
                    <div>
                        <a class="btn btn-primary-custom btn-sm rounded-pill" asp-action="Create">Propose a Swap</a>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var swap in outgoing)
                    {
                        <div class="col-lg-6">
                            <div class="card card-custom p-4 bg-white border h-100 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(swap.ReceiverAvatarUrl))
                                        {
                                            <img src="http://localhost:5200@(swap.ReceiverAvatarUrl)" alt="@swap.ReceiverName" class="avatar-circle" style="width:48px; height:48px;" onerror="this.src='/images/default-avatar.png';">
                                        }
                                        else
                                        {
                                            var initial = !string.IsNullOrEmpty(swap.ReceiverName) ? swap.ReceiverName[0].ToString().ToUpper() : "U";
                                            <div class="avatar-placeholder" style="width:48px; height:48px;">@initial</div>
                                        }
                                        <div>
                                            <h6 class="fw-bold mb-0">To: @swap.ReceiverName</h6>
                                            <small class="text-muted">Sent @swap.CreatedAt.ToString("MMM dd, yyyy")</small>
                                        </div>
                                    </div>
                                    <span class="badge-status @swap.Status">@swap.Status</span>
                                </div>

                                <div class="p-3 bg-light rounded-4 mb-3 border">
                                    <div class="row g-2 align-items-center text-center">
                                        <div class="col-5">
                                            <small class="text-muted fw-bold d-block mb-1" style="font-size:0.75rem;">YOU TEACH</small>
                                            <span class="badge bg-primary text-white rounded-pill px-3 py-1">@swap.OfferedSkillName</span>
                                        </div>
                                        <div class="col-2">
                                            <i class="bi bi-arrow-left-right text-primary"></i>
                                        </div>
                                        <div class="col-5">
                                            <small class="text-muted fw-bold d-block mb-1" style="font-size:0.75rem;">THEY TEACH</small>
                                            <span class="badge bg-secondary text-white rounded-pill px-3 py-1">@swap.RequestedSkillName</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="small text-muted mb-3 d-flex flex-wrap gap-3">
                                    <span><i class="bi bi-calendar3 me-1 text-primary"></i>@swap.ProposedDate.ToString("ddd, MMM dd - hh:mm tt")</span>
                                    <span><i class="bi bi-clock me-1 text-primary"></i>@swap.DurationMinutes mins</span>
                                </div>

                                @if (swap.Status == SwapRequestStatus.Accepted)
                                {
                                    <div class="mt-auto pt-2 border-top">
                                        <a class="btn btn-primary-custom btn-sm w-100" asp-controller="Sessions" asp-action="Index">
                                            <i class="bi bi-camera-video me-1"></i> View Scheduled Session
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
