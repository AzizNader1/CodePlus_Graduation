@model SkillSwap.Application.DTOs.Verify2FaRequest
@{
    ViewData["Title"] = "Two-Factor Authentication";
}

<div class="container py-5 my-md-4">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card card-custom p-4 p-md-5 border-0 shadow-lg text-center">
                <div class="brand-badge mb-3 mx-auto" style="width:52px; height:52px; border-radius:14px; font-size:1.5rem; background:linear-gradient(135deg, #0d9488, #14b8a6);">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h3 class="fw-bold mb-1">Two-Factor Authentication</h3>
                <p class="text-muted small mb-4">Enter the 6-digit verification code from your authenticator app.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-4 small p-3 border-0 mb-4 text-start">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="TwoFactor" method="post">
                    <input type="hidden" asp-for="TwoFactorToken" />

                    <div class="mb-4">
                        <input asp-for="Code" class="form-control form-control-lg text-center fw-bold fs-3 tracking-widest bg-light rounded-4 py-2" placeholder="000000" maxlength="6" autofocus required />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">Verify & Sign In</button>
                    <a asp-action="Login" class="small text-muted text-decoration-none">Back to Sign In</a>
                </form>
            </div>
        </div>
    </div>
</div>
