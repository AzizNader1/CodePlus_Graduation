@model SkillSwap.Application.DTOs.ResetPasswordRequest
@{
    ViewData["Title"] = "Set New Password";
}

<div class="container py-5 my-md-4">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card card-custom p-4 p-md-5 border-0 shadow-lg text-center">
                <div class="brand-badge mb-3 mx-auto" style="width:52px; height:52px; border-radius:14px; font-size:1.5rem; background:linear-gradient(135deg, #10b981, #059669);">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h3 class="fw-bold mb-1">Set New Password</h3>
                <p class="text-muted small mb-4">Choose a strong password to secure your SkillSwap account.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-4 small p-3 border-0 mb-4 text-start">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="ResetPassword" method="post" class="text-start">
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="NewPassword" type="password" class="form-control bg-light border-start-0 py-2" placeholder="••••••••" required autofocus />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                            <input name="confirmPassword" id="confirmPassword" type="password" class="form-control bg-light border-start-0 py-2" placeholder="••••••••" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">Update Password</button>
                    <div class="text-center">
                        <a asp-action="Login" class="small text-muted text-decoration-none">Back to Sign In</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
