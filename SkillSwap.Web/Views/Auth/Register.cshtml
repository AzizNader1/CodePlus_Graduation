@model SkillSwap.Application.DTOs.RegisterRequest
@{
    ViewData["Title"] = "Create your SkillSwap Account";
}

<div class="container py-5 my-md-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card card-custom p-4 p-md-5 border-0 shadow-lg">
                <div class="text-center mb-4">
                    <div class="brand-badge mb-3 mx-auto" style="width:52px; height:52px; border-radius:14px; font-size:1.5rem;">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Create your account</h3>
                    <p class="text-muted small">Join a global network of mentors, learners, and swappers</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-4 small p-3 border-0 mb-4">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control bg-light border-start-0 py-2" placeholder="e.g. Alex Morgan" required />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control bg-light border-start-0 py-2" placeholder="name@example.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" type="password" class="form-control bg-light border-start-0 py-2" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                                <input name="confirmPassword" id="confirmPassword" type="password" class="form-control bg-light border-start-0 py-2" placeholder="••••••••" required />
                            </div>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="agreeTerms" required checked>
                        <label class="form-check-label small text-muted" for="agreeTerms">
                            I agree to the <a href="#" class="text-primary text-decoration-none">Terms of Service</a> and <a href="#" class="text-primary text-decoration-none">Privacy Policy</a>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">Create Free Account</button>
                </form>

                <p class="text-center small text-muted mb-0">
                    Already have an account? <a asp-action="Login" class="fw-bold text-primary text-decoration-none">Sign in here</a>
                </p>
            </div>
        </div>
    </div>
</div>
