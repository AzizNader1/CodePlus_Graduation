@model SkillSwap.Application.DTOs.ForgotPasswordRequest
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5 my-md-4">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card card-custom p-4 p-md-5 border-0 shadow-lg text-center">
                <div class="brand-badge mb-3 mx-auto" style="width:52px; height:52px; border-radius:14px; font-size:1.5rem; background:linear-gradient(135deg, #f59e0b, #d97706);">
                    <i class="bi bi-key"></i>
                </div>
                <h3 class="fw-bold mb-1">Reset your password</h3>
                <p class="text-muted small mb-4">Enter your verified email and we'll send you recovery instructions.</p>

                <form asp-action="ForgotPassword" method="post">
                    <div class="mb-4 text-start">
                        <label class="form-label small fw-bold text-muted">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control bg-light border-start-0 py-2" placeholder="name@example.com" required autofocus />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">Send Reset Link</button>
                    <a asp-action="Login" class="small text-muted text-decoration-none">Back to Sign In</a>
                </form>
            </div>
        </div>
    </div>
</div>
