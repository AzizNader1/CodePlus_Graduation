@model SkillSwap.Application.DTOs.UserProfileDTO
@{
    ViewData["Title"] = "My Profile - " + Model.FullName;
}

<div class="container-xl py-5">
    <!-- Profile Header Card -->
    <div class="card card-custom p-4 p-md-5 mb-5 border-0 shadow-sm bg-white">
        <div class="row align-items-center g-4">
            <div class="col-md-auto text-center position-relative">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="http://localhost:5200@(Model.AvatarUrl)" alt="@Model.FullName" class="avatar-lg" style="width:110px; height:110px;" onerror="this.src='/images/default-avatar.png';">
                }
                else
                {
                    var initial = !string.IsNullOrEmpty(Model.FullName) ? Model.FullName[0].ToString().ToUpper() : "U";
                    <div class="avatar-placeholder" style="width:110px; height:110px; font-size:2.5rem;">@initial</div>
                }
                <button type="button" class="btn btn-light btn-sm rounded-circle position-absolute bottom-0 end-0 shadow-sm border p-2" data-bs-toggle="modal" data-bs-target="#uploadAvatarModal" title="Change Avatar">
                    <i class="bi bi-camera-fill text-muted"></i>
                </button>
            </div>

            <div class="col-md">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                    <div>
                        <h2 class="fw-bold mb-1">@Model.FullName</h2>
                        <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                            <span><i class="bi bi-envelope me-1"></i>@Model.Email</span>
                            <span><i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrEmpty(Model.Location) ? "Location not set" : Model.Location)</span>
                            <span><i class="bi bi-calendar3 me-1"></i>Member since @Model.CreatedAt.ToString("MMM yyyy")</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-secondary-custom btn-sm" asp-action="Edit">
                            <i class="bi bi-pencil me-1"></i> Edit Profile
                        </a>
                        <a class="btn btn-outline-primary btn-sm" asp-action="User" asp-route-userId="@Model.Id" title="View Public Profile">
                            <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                </div>

                <p class="text-muted mt-3 mb-3">
                    @(string.IsNullOrEmpty(Model.Bio) ? "No bio provided yet. Click 'Edit Profile' to introduce yourself to the community." : Model.Bio)
                </p>

                <!-- Metrics Strip -->
                <div class="d-flex flex-wrap gap-4 pt-3 border-top text-muted small">
                    <div>
                        <i class="bi bi-star-fill text-warning me-1"></i>
                        <strong class="text-dark fs-6">@(Model.AverageRating > 0 ? Model.AverageRating.ToString("F1") : "5.0")</strong>
                        <span>Average Rating</span>
                    </div>
                    <div>
                        <i class="bi bi-arrow-left-right text-primary me-1"></i>
                        <strong class="text-dark fs-6">@Model.TotalSwapsCompleted</strong>
                        <span>Swaps Completed</span>
                    </div>
                    <div>
                        <i class="bi bi-chat-heart text-danger me-1"></i>
                        <strong class="text-dark fs-6">@Model.TotalReviewsCount</strong>
                        <span>Reviews Received</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Skills Offered -->
        <div class="col-lg-6">
            <div class="card card-custom p-4 h-100 bg-white border">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold mb-0"><i class="bi bi-mortarboard text-primary me-2"></i>Skills I Can Teach</h5>
                        <small class="text-muted">Abilities you offer to swap partners</small>
                    </div>
                    <a class="btn btn-primary-custom btn-sm" asp-action="Edit">
                        <i class="bi bi-plus-lg me-1"></i> Manage
                    </a>
                </div>

                @if (Model.SkillsOffered == null || !Model.SkillsOffered.Any())
                {
                    <div class="p-4 text-center bg-light rounded-4 border border-dashed">
                        <p class="text-muted small mb-3">You haven't listed any skills you teach yet.</p>
                        <a class="btn btn-outline-primary btn-sm rounded-pill" asp-action="Edit">Add Your First Skill</a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var skill in Model.SkillsOffered)
                        {
                            <div class="p-3 bg-light rounded-4 border d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h6 class="fw-bold mb-0">@skill.SkillName</h6>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">@skill.ProficiencyLevel</span>
                                    </div>
                                    <small class="text-muted d-block mb-1">
                                        <i class="bi bi-award me-1"></i>@skill.YearsOfExperience years experience
                                    </small>
                                    @if (!string.IsNullOrEmpty(skill.Description))
                                    {
                                        <p class="small text-muted mb-0">@skill.Description</p>
                                    }
                                </div>
                                <form asp-action="DeleteOfferedSkill" method="post" onsubmit="return confirm('Remove this skill?');">
                                    <input type="hidden" name="userSkillId" value="@skill.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm border-0" title="Delete Skill">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Right Column: Skills Desired (Wishlist) -->
        <div class="col-lg-6">
            <div class="card card-custom p-4 h-100 bg-white border">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold mb-0"><i class="bi bi-compass text-secondary me-2"></i>Skills I Want to Learn</h5>
                        <small class="text-muted">Skills you are looking to acquire from others</small>
                    </div>
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Edit">
                        <i class="bi bi-plus-lg me-1"></i> Manage
                    </a>
                </div>

                @if (Model.SkillsWanted == null || !Model.SkillsWanted.Any())
                {
                    <div class="p-4 text-center bg-light rounded-4 border border-dashed">
                        <p class="text-muted small mb-3">You haven't listed any learning goals yet.</p>
                        <a class="btn btn-outline-secondary btn-sm rounded-pill" asp-action="Edit">Add Wanted Skills</a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var wanted in Model.SkillsWanted)
                        {
                            <div class="p-3 bg-light rounded-4 border d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-1">@wanted.SkillName</h6>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill">
                                        Priority: @wanted.Priority
                                    </span>
                                </div>
                                <form asp-action="DeleteWantedSkill" method="post" onsubmit="return confirm('Remove this skill from wishlist?');">
                                    <input type="hidden" name="wantedSkillId" value="@wanted.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm border-0" title="Remove Wishlist Item">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: Upload Avatar -->
<div class="modal fade" id="uploadAvatarModal" tabindex="-1" aria-labelledby="avatarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="avatarModalLabel">Update Profile Avatar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data">
                <div class="modal-body py-4">
                    <p class="text-muted small mb-3">Choose a JPEG, PNG, or WebP photo (maximum 5MB).</p>
                    <input type="file" name="file" class="form-control rounded-3" accept=".jpg,.jpeg,.png,.webp" required />
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom rounded-pill px-4">Upload Photo</button>
                </div>
            </form>
        </div>
    </div>
</div>
