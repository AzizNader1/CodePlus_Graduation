@model SkillSwap.Application.DTOs.UpdateProfileRequest
@{
    ViewData["Title"] = "Edit Profile & Skills";
    var masterSkills = ViewBag.MasterSkills as List<SkillDTO> ?? new List<SkillDTO>();
    var profile = ViewBag.Profile as UserProfileDTO;
}

<div class="container-xl py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold mb-1">Edit Profile & Skills</h3>
            <p class="text-muted small mb-0">Update your public biography, location, and the skills you exchange.</p>
        </div>
        <a class="btn btn-secondary-custom btn-sm" asp-action="Index">
            &larr; Back to Profile
        </a>
    </div>

    <div class="row g-4">
        <!-- Left: Basic Details Form -->
        <div class="col-lg-6">
            <div class="card card-custom p-4 bg-white border mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-person text-primary me-2"></i>Personal Details</h5>
                
                <form asp-action="Edit" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Full Name</label>
                        <input asp-for="FullName" class="form-control rounded-3" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Location / Timezone</label>
                        <input asp-for="Location" class="form-control rounded-3" placeholder="e.g. San Francisco, CA or GMT+2" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">About Me (Bio)</label>
                        <textarea asp-for="Bio" rows="4" class="form-control rounded-3" placeholder="Share your background, what you enjoy mentoring, and what you're passionate about learning..."></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100">Save Changes</button>
                </form>
            </div>
        </div>

        <!-- Right: Add Skills -->
        <div class="col-lg-6">
            <!-- Add Skill Offered -->
            <div class="card card-custom p-4 bg-white border mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-mortarboard text-success me-2"></i>Add Skill You Can Teach</h5>
                
                <form asp-action="AddOfferedSkill" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Select Skill</label>
                        <select name="SkillId" class="form-select rounded-3" required>
                            <option value="">-- Choose a skill from catalog --</option>
                            @foreach (var s in masterSkills)
                            {
                                <option value="@s.Id">@s.Name (@s.CategoryName)</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Proficiency</label>
                            <select name="ProficiencyLevel" class="form-select rounded-3">
                                @foreach (ProficiencyLevel lvl in Enum.GetValues(typeof(ProficiencyLevel)))
                                {
                                    <option value="@lvl">@lvl</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Years Experience</label>
                            <input type="number" name="YearsOfExperience" class="form-control rounded-3" min="0" max="50" value="1" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Experience Details (Optional)</label>
                        <input type="text" name="Description" class="form-control rounded-3" placeholder="e.g. 5+ years building production ASP.NET Core APIs." />
                    </div>

                    <button type="submit" class="btn btn-success w-100 rounded-3 fw-semibold">Add Offered Skill</button>
                </form>
            </div>

            <!-- Add Skill Wanted -->
            <div class="card card-custom p-4 bg-white border">
                <h5 class="fw-bold mb-3"><i class="bi bi-compass text-secondary me-2"></i>Add Skill You Want to Learn</h5>
                
                <form asp-action="AddWantedSkill" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Select Desired Skill</label>
                        <select name="SkillId" class="form-select rounded-3" required>
                            <option value="">-- Choose a skill to learn --</option>
                            @foreach (var s in masterSkills)
                            {
                                <option value="@s.Id">@s.Name (@s.CategoryName)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Priority Level</label>
                        <select name="PriorityLevel" class="form-select rounded-3">
                            <option value="1">High Priority</option>
                            <option value="2" selected>Medium Priority</option>
                            <option value="3">Low Priority</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-outline-secondary w-100 rounded-3 fw-semibold">Add to Wishlist</button>
                </form>
            </div>
        </div>
    </div>
</div>
